%% Browsers send every cookie set on "localhost" to every port, so after a few dev projects the
%% Cookie header outgrows the management UI's default limit (about 10 KB) and it answers
%% "431 Request Header Fields Too Large". rabbitmq.conf has no key for this, so pass the limit
%% straight to Cowboy, the web server behind the management UI.
[
  {rabbitmq_management, [
    {tcp_config, [
      {port, 15672},
      {cowboy_opts, [{max_header_value_length, 65536}]}
    ]}
  ]}
].
